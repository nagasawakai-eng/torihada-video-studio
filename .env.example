# Fish Audio (TTS) APIキー https://fish.audio/ のダッシュボードで発行
FISHAUDIO_API_KEY=

# Googleログインによる社内限定公開（@torihada.co.jp のアカウントのみ許可）
# GOOGLE_CLIENT_IDを設定すると自動的にログイン必須になります。未設定なら認証なしで公開されます。
# 取得手順はREADME.mdを参照してください。
GOOGLE_CLIENT_ID=
ALLOWED_DOMAIN=torihada.co.jp

# ログインセッションの署名に使う秘密鍵。ランダムな文字列を1つ決めて設定してください。
# 未設定でも動きますが、サーバー再起動のたびに全員ログインし直しになります。
# 生成例: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# 任意: 将来AIによる台本自動生成を追加する場合に使用（現状は未使用）
ANTHROPIC_API_KEY=

PORT=3000
